

{# The event queue, defined before the script and everywhere it runs.

   Custom events call `window.plausible(...)`. Without this a call made before
   the script finishes loading would throw and the event would be lost. Defining
   it outside the deployed environments too means the events can be read off
   `window.plausible.q` in development without anything being sent. #}
<script>
    window.plausible = window.plausible || function () {
        (window.plausible.q = window.plausible.q || []).push(arguments);
    };
</script>

{% if (request is defined and not request.is_preview) %}
        {# `outbound-links` is one of the twelve metrics OO asked for: the base
           script does not count clicks that leave the site. #}
        {% if server_env == 'staging' %}
            <script defer data-domain="openownership.hactar.work" src="https://plausible.io/js/script.file-downloads.outbound-links.js"></script>
        {% elif server_env == 'production' %}
            <script defer data-domain="openownership.org" src="https://plausible.io/js/script.file-downloads.outbound-links.js"></script>
        {% endif %}
{% endif %}


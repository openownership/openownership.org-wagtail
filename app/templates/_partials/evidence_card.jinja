{# One evidence record as a card.

Expects:

* entry - An ImpactEntry

Reuses the card-group classes so it picks up the existing card styling. The
expand control is an ordinary link to the record's own page, upgraded by htmx
into an in-place swap, so the listing still works with JavaScript off.
#}
<li class="card-group__card card-group__card--without-thumbnail evidence-card"
    id="evidence-{{ entry.notion_id }}">

    <div class="card-group__card-decoration">

        {# A plain edge down the side of every card. It marks a record out from
           the page rather than standing for anything, so its colour is the
           stylesheet's business. #}
        <span class="evidence-card__edge"></span>

        {# Collapsed cards show description, jurisdiction, topic and year only.
           Everything else appears when the record is expanded.

           The icon sits beside the topic name, never instead of it, so a topic
           we have not drawn yet costs a reader nothing. #}
        <div class="card-group__meta">
            {% with tags = entry.policy_areas.all() %}
                {% include "_partials/topic_tags.jinja" %}
            {% endwith %}
        </div>

        <div class="card-group__text">
            {# `h3`, because this sits inside the results section headed by
               "Evidence records". `tabindex` so focus can be moved here when
               the record is opened, which is what tells a screen reader
               reader something happened. #}
            <h3 class="card-group__title" tabindex="-1">{{ entry.description }}</h3>

            {% if entry.summary %}
                <p class="card-group__blurb">{{ entry.display_summary }}</p>
            {% endif %}

            <p class="card-group__date evidence-card__facts">
                {% if entry.year %}
                    <span class="evidence-card__year">
                        {%- with param = "year", value = entry.year, css_class = "year-tag",
                                 prefix = _("Show records from") -%}
                            {%- include "_partials/facet_link.jinja" -%}
                        {%- endwith -%}
                    </span>
                {% endif %}

                {% with countries = entry.countries.all() %}
                    {% if countries|length %}
                        <span class="evidence-card__jurisdictions">
                            {% for country in countries %}
                                {%- with param = "jurisdiction", value = country.name,
                                         css_class = "jurisdiction-tag",
                                         prefix = _("Show records from") -%}
                                    {%- include "_partials/facet_link.jinja" -%}
                                {%- endwith -%}
                                {%- if not loop.last %}, {% endif -%}
                            {% endfor %}
                        </span>
                    {% elif entry.worldwide %}
                        {# What the tracker itself shows for a worldwide record. #}
                        <span class="evidence-card__jurisdictions">{% trans %}Global{% endtrans %}</span>
                    {% elif entry.international %}
                        <span class="evidence-card__jurisdictions">{% trans %}International{% endtrans %}</span>
                    {% endif %}
                {% endwith %}

                {% for name in entry.display_card_regions %}
                    {% with param = "region", value = name, css_class = "region-tag",
                            prefix = _("Show records in") %}
                        {% include "_partials/facet_link.jinja" %}
                    {% endwith %}
                {% endfor %}
            </p>

            {% if entry.source_url %}
                <p class="evidence-card__source">
                    {# The data attributes are what an outbound click reports to
                       Plausible, so OO can break the clicks down. #}
                    <a href="{{ entry.source_url }}"
                       rel="noopener"
                       target="_blank"
                       data-topic="{{ entry.display_topics }}"
                       data-jurisdiction="{{ entry.display_jurisdictions }}"
                       data-region="{{ entry.display_region_names }}">
                        {% trans %}View source{% endtrans %}
                        {% include "svg/external-link.jinja" %}
                    </a>
                </p>
            {% endif %}

            <p class="evidence-card__toggle">
                {# `hx-get` carries the reader's filters so the open card's own
                   topic tags still know what they had chosen. `href` and
                   `hx-push-url` stay clean, because those are what gets shared. #}
                <a href="{{ entry.get_absolute_url() }}"
                   hx-get="{{ entry.get_absolute_url() }}{% with query = evidence_query.querystring() if evidence_query else '' %}{% if query %}?{{ query }}{% endif %}{% endwith %}"
                   hx-target="closest .evidence-card"
                   hx-swap="outerHTML"
                   hx-push-url="true">
                    {% trans %}Read more{% endtrans %}
                    <span class="sr-only">{% trans %}about{% endtrans %} {{ entry.description }}</span>
                </a>
            </p>
        </div>
    </div>
</li>
